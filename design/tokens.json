{
  "$description": "Ink Dimensions design tokens (W3C DTCG format). Neutral, structural palette. Generate CSS and TS with intake.py tokens; never edit the generated files.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#ffffff", "$description": "Page background" },
    "surface": { "$value": "#f4f5f7", "$description": "Panels, cards and the app header" },
    "surface-strong": { "$value": "#e6e8ec", "$description": "Selected and hovered surfaces" },
    "text": { "$value": "#1b1f24", "$description": "Body text" },
    "text-muted": { "$value": "#47505c", "$description": "Secondary text" },
    "border": { "$value": "#6b7480", "$description": "Control borders (3:1 against backgrounds)" },
    "border-subtle": { "$value": "#d0d4da", "$description": "Decorative dividers only" },
    "primary": { "$value": "#1d4ed8", "$description": "Primary actions and links" },
    "primary-hover": { "$value": "#1e3a8a" },
    "on-primary": { "$value": "#ffffff", "$description": "Text on primary" },
    "danger": { "$value": "#b42318" },
    "on-danger": { "$value": "#ffffff" },
    "success": { "$value": "#146c2e" },
    "warning-bg": { "$value": "#fff4d6" },
    "warning-text": { "$value": "#5c3d00" },
    "focus": { "$value": "#1d4ed8", "$description": "Focus ring" },
    "comic": {
      "paper": { "$value": "#ffffff" },
      "ink": { "$value": "#111418" },
      "bubble": { "$value": "#ffffff" },
      "caption": { "$value": "#fff4d6" },
      "placeholder-fill": { "$value": "#e6e8ec" },
      "placeholder-shape": { "$value": "#9aa1ab" },
      "placeholder-text": { "$value": "#33393f" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.5, "unit": "rem" } },
    "6": { "$value": { "value": 2, "unit": "rem" } },
    "7": { "$value": { "value": 3, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 0.25, "unit": "rem" } },
    "md": { "$value": { "value": 0.5, "unit": "rem" } }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } },
    "focus": { "$value": { "value": 3, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "content-max": { "$value": { "value": 72, "unit": "rem" } },
    "form-max": { "$value": { "value": 28, "unit": "rem" } },
    "thumb": { "$value": { "value": 6, "unit": "rem" } },
    "reader-max": { "$value": { "value": 48, "unit": "rem" } },
    "textarea-min": { "$value": { "value": 8, "unit": "rem" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 1.25, "unit": "rem" } },
      "xl": { "$value": { "value": 1.75, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 650 }
    },
    "line-height": {
      "$type": "number",
      "body": { "$value": 1.5 },
      "tight": { "$value": 1.2 }
    }
  }
}
