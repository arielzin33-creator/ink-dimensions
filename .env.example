# Ink Dimensions configuration. Every variable is optional: with none set, the app runs on
# in-process PGlite, local file storage and deterministic twins (no network, no keys).
# Copy to .env for your own use; never commit real secrets.

# --- Runtime -------------------------------------------------------------------------------
NODE_ENV=development            # development | production | test
HOST=127.0.0.1                  # 0.0.0.0 by default in production
PORT=3000
RELEASE=dev                     # release version written on every log line and error
LOG_LEVEL=info                  # debug | info | warn | error | silent
COOKIE_SECURE=                  # defaults to true when NODE_ENV=production
UPLOAD_MAX_BYTES=5242880        # per image, decoded (5 MB)

# --- Database ------------------------------------------------------------------------------
# Set DATABASE_URL to use PostgreSQL through `pg`. Without it, PGlite (in-process Postgres)
# stores data in PGLITE_DIR; use memory:// for a throwaway database.
DATABASE_URL=                   # e.g. postgres://ink:password@localhost:5432/ink
PGLITE_DIR=.data/pglite
MIGRATIONS_DIR=migrations

# --- File storage (photos, reference art, panel images) -----------------------------------
STORAGE_PROVIDER=local          # local | memory (memory is for tests, refused in production)
STORAGE_DIR=.data/storage

# --- Script generation (LLM) ---------------------------------------------------------------
LLM_PROVIDER=twin               # twin | anthropic | local
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=8000
# anthropic: Claude Messages API (adapter untested against the live service)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                # a current Claude model id from Anthropic's documentation
ANTHROPIC_BASE_URL=             # default https://api.anthropic.com
# local: any OpenAI-compatible chat completions server, e.g. Ollama (http://127.0.0.1:11434)
# or llama.cpp server (http://127.0.0.1:8080). The adapter appends /v1/chat/completions.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=                # e.g. the model name pulled into Ollama
LOCAL_LLM_API_KEY=              # optional bearer token

# --- Panel images --------------------------------------------------------------------------
IMAGE_PROVIDER=twin             # twin | hosted | comfyui
IMAGE_TIMEOUT_MS=180000
# hosted: generic HTTPS JSON contract (see src/providers/image/hosted.ts); untested live
HOSTED_IMAGE_URL=
HOSTED_IMAGE_API_KEY=
HOSTED_IMAGE_ALLOW_PHOTOS=false # owner decision pending (spec FR-022); photos stay local by default
# comfyui: self-hosted ComfyUI-style server; untested live
COMFYUI_URL=                    # e.g. http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=          # API-format workflow JSON with {{prompt}} placeholders
COMFYUI_POLL_MS=1000

# --- Moderation ----------------------------------------------------------------------------
MODERATION_PROVIDER=rules       # rules | permissive (permissive is refused in production)

# --- Feature flags (OpenFeature, flagd JSON format) ---------------------------------------
# Edit the file (or mount another one) to switch photo-path-enabled / render-enabled; the
# server notices the change within about a second, no restart or deploy needed.
FLAGS_FILE=flags/flags.json

# --- Development ---------------------------------------------------------------------------
DEV_VITE=                       # set by `npm run dev` to serve the UI through Vite middleware
WEB_DIR=dist/web
