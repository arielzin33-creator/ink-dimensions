{
  "name": "ink-dimensions",
  "version": "0.1.0",
  "private": true,
  "description": "Ink Dimensions web v1: an AI comics generator from your own characters, plot and style.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/node/server/main.js",
    "dev": "DEV_VITE=1 tsx watch --clear-screen=false src/server/main.ts",
    "test:e2e": "npm run build && playwright test",
    "db:migrate": "tsx src/server/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "1.23.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0",
    "minimatch": "11.0.4"
  }
}
